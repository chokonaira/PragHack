# Copy to .env (gitignored) and fill in. Never commit real keys.
# Server-only values: Nuxt maps NUXT_* variables onto runtimeConfig on the server.

# Mock API host (no /servicebridgeapi prefix, see docs/api/README.md)
NUXT_API_BASE=http://mockapi.pragvue.cz:8001

# Use seeded demo data instead of the live mock
NUXT_DEMO_MODE=false

# Demo tickets with the real model (needs the key below). Leave false on the public site.
NUXT_AI_LIVE=false

# Real LLM used by our server routes. Default provider is Anthropic (see docs/contracts.md).
NUXT_LLM_PROVIDER=anthropic
NUXT_LLM_BASE_URL=https://api.anthropic.com
NUXT_LLM_API_KEY=
NUXT_LLM_MODEL=claude-sonnet-5-5

# Shared demo state across server instances (needed on Vercel). Any Redis over TCP, redis://user:password@host:port
# Leave empty locally. Never commit it.
REDIS_URL=
